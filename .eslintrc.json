{
  "extends": [
    "airbnb-base",
    "prettier"
  ],
  "plugins": [
    "prettier"
  ],
  "rules": {
    "prettier/prettier": ["error"],
    "no-console": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-underscore-dangle": "off",
    "consistent-return": "off"
  },
  "env": {
    "node": true,
    "es2021": true
  }
}
