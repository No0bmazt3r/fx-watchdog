{
	"info": {
		"_postman_id": "a8a1b3a3-1b3c-4c3e-8b1a-9e8e1f1d0c2c",
		"name": "FX Watchdog API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "1. Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"pm.collectionVariables.set(\"authToken\", response.token);",
									"pm.collectionVariables.set(\"isTemporaryPassword\", response.isTemporaryPassword);",
									"pm.collectionVariables.set(\"userId\", response.user.id);",
									"pm.collectionVariables.set(\"username\", response.user.username);",
									"pm.collectionVariables.set(\"userRole\", response.user.role);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"SuperAdmin\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in a user and returns a JWT, user details, and a flag for temporary passwords. Automatically sets authToken, isTemporaryPassword, userId, username, and userRole collection variables."
					},
					"response": []
				},
				{
					"name": "2. Change Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"newPassword\": \"a_strong_password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/change-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"change-password"
							]
						},
						"description": "Changes the user's password. Requires a valid JWT. Returns `success: true` on success."
					},
					"response": []
				}
			]
		},
		{
			"name": "User Management",
			"item": [
				{
					"name": "1. Get All Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
							"users"
						]
						},
						"description": "Retrieves a list of all users. Requires Admin or SuperAdmin role."
					},
					"response": []
				},
				{
					"name": "2. SuperAdmin - Create Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"newadmin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin_temp_pass\",\n  \"role\": \"Admin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
							"users"
						]
						},
						"description": "SuperAdmin creates a new Admin user."
					},
					"response": []
				},
				{
					"name": "3. Admin - Create Ops User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"opsuser1\",\n  \"email\": \"ops@example.com\",\n  \"password\": \"ops_temp_pass\",\n  \"role\": \"Ops User\",\n  \"branch\": \"Main Branch\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
							"users"
						]
						},
						"description": "Admin creates a new Ops User."
					},
					"response": []
				},
				{
					"name": "4. SuperAdmin - Delete Admin",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
							"users",
							":id"
						],
							"variable": [
								{
									"key": "id",
									"value": "<admin_user_id_to_delete>"
								}
							]
						},
						"description": "SuperAdmin deletes an Admin user. Replace :id with the actual user ID."
					},
					"response": []
				},
				{
					"name": "5. Admin - Delete Ops User",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
							"users",
							":id"
						],
							"variable": [
								{
									"key": "id",
									"value": "<ops_user_id_to_delete>"
								}
							]
						},
						"description": "Admin deletes an Ops User. Replace :id with the actual user ID."
					},
					"response": []
				}
			]
		},
		{
			"name": "Ops User Workflow",
			"item": [
				{
					"name": "1. Upload Image (for Review)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "image",
									"type": "file",
									"src": []
								},
								{
									"key": "branch",
									"value": "Main Branch",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/uploads",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"uploads"
							]
						},
						"description": "Uploads an image and branch name to be processed for review. Requires a valid JWT. The server returns a tempFileId."
					},
					"response": []
				},
				{
					"name": "2. Submit Verified Data",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tempFileId\": \"<temp_file_id_from_upload>\",\n  \"uploadId\": \"<upload_id_from_upload>\",\n  \"extractedData\": {\n    \"date\": \"2025-07-29\",\n    \"time\": \"09:30\",\n    \"branch\": \"Main Branch\",\n    \"rates\": {\n      \"IDR\": 3847.76,\n      \"PHP\": 13.51\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/submit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"submit"
							]
						},
						"description": "Submits the user-verified data to the server for final storage. The body for this request can be the exact JSON response from the 'Upload Image' request."
					},
					"response": []
				},
				{
					"name": "3. Retrieve Image",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/uploads/image/<upload_id>",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"uploads",
								"image",
								"<upload_id>"
							]
						},
						"description": "Retrieves a previously uploaded image by its upload ID. The ID is returned in the response from the upload endpoint."
					},
					"response": []
				}
			]
		}
	]
}
