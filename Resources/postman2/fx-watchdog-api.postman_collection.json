					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Retrieves a list of all users."
					},
					"response": []
				},
				{
					"name": "SuperAdmin - Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"new_admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"temporary_password\",\n  \"role\": \"Admin\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "SuperAdmin creates a new user. The 'role' can be 'Admin' or 'Ops User'. If creating an 'Ops User', the 'branch' field is required."
					},
					"response": []
				},
				{
					"name": "Admin - Create Ops User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"opsuser1\",\n  \"email\": \"ops@example.com\",\n  \"password\": \"ops_temp_pass\",\n  \"role\": \"Ops User\",\n  \"branch\": \"Main Branch\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Admin creates a new Ops User. Make sure you are logged in as an Admin."
					},
					"response": []
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users/{{userId_to_delete}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"{{userId_to_delete}}"
							]
						},
						"description": "Deletes a user by ID. Set userId_to_delete collection variable with the actual user ID."
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{authToken}}",
						"type": "string"
					}
				]
			}
		},
		{
			"name": "3. Branch Management (Admin/SuperAdmin Only)",
			"item": [
				{
					"name": "Create Branch",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Main Branch\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/branches",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"branches"
							]
						},
						"description": "Creates a new branch. Requires Admin or SuperAdmin privileges."
					},
					"response": []
				},
				{
					"name": "Get All Branches",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/branches",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"branches"
							]
						},
						"description": "Retrieves a list of all branches. Requires Admin or SuperAdmin privileges."
					},
					"response": []
				},
				{
					"name": "Delete Branch",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/branches/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"branches",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "<branch_id_to_delete>"
								}
							]
						},
						"description": "Deletes a branch by ID. Requires SuperAdmin privileges. Replace :id with the actual branch ID."
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{authToken}}",
						"type": "string"
					}
				]
			}
		},
		{
			"name": "4. Rate Card Workflow",
			"item": [
				{
					"name": "Ops User Workflow",
					"item": [
						{
							"name": "Step 1a: Upload Image for Extraction",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"try {",
											"    let jsonData = pm.response.json();",
											"    if (jsonData && jsonData.uploadId) {",
											"        pm.collectionVariables.set('uploadId', jsonData.uploadId);",
											"        pm.collectionVariables.set('extractedData', JSON.stringify(jsonData.extractedData, null, 2));",
											"    }",
											"} catch (e) {",
											"    console.error('Error parsing upload response:', e);",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "formdata",
									"formdata": [
										{
											"key": "image",
											"type": "file",
											"src": []
										},
										{
											"key": "branch",
											"value": "Main Branch",
											"type": "text"
										}
									]
								},
								"url": {
								"raw": "{{base_url}}/api/uploads",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads"
								]
							},
							"description": "Uploads an image and branch name. The API returns extracted data with a 'Pending' status."
						},
						"response": []
					},
					{
						"name": "Step 1b: Upload Text for Extraction",
						"event": [
							{
								"listen": "test",
								"script": {
									"exec": [
										"try {",
										"    let jsonData = pm.response.json();",
										"    if (jsonData && jsonData.uploadId) {",
										"        pm.collectionVariables.set('uploadId', jsonData.uploadId);",
										"        pm.collectionVariables.set('extractedData', JSON.stringify(jsonData.extractedData, null, 2));",
										"    }",
										"} catch (e) {",
										"    console.error('Error parsing upload response:', e);",
										"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{,\n  \"branch\": \"Main Branch\"\n}",
								"options": {
									"raw": {
										"language": "json"
									}
								}
							},
							"url": {
								"raw": "{{base_url}}/api/uploads",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads"
								]
							},
							"description": "Uploads raw text for extraction. The API returns extracted data with a 'Pending' status."
						},
						"response": []
					},
					{
						"name": "Step 2: Submit Verified Data",
						"request": {
							"method": "POST",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": {
								"mode": "raw",
								"raw": "{\n  \"uploadId\": \"{{uploadId}}\",\n  \"extractedData\": {{extractedData}}\n}",
								"options": {
									"raw": {
										"language": "json"
									}
								}
							},
							"url": {
								"raw": "{{base_url}}/api/submit",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"submit"
								]
							},
							"description": "Submits the verified data. The body can be the direct response from the upload endpoint. On success, the upload status is changed to 'Completed'."
						},
						"response": []
					},
					{
						"name": "Get Upload History",
						"request": {
							"method": "GET",
							"header": [],
							"url": {
								"raw": "{{base_url}}/api/uploads/history?page=1&limit=10",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads",
									"history"
								],
								"query": [
									{
										"key": "page",
										"value": "1"
									},
									{
										"key": "limit",
										"value": "10"
									}
								]
							},
							"description": "Retrieves a paginated list of upload history for the authenticated user."
						},
						"response": []
					},
					{
						"name": "Get Latest Upload",
						"request": {
							"method": "GET",
							"header": [],
							"url": {
								"raw": "{{base_url}}/api/uploads/latest",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads",
									"latest"
								]
							},
							"description": "Retrieves the latest upload for the authenticated user."
						},
						"response": []
					},
					{
						"name": "Discard Last Upload",
						"request": {
							"method": "DELETE",
							"header": [],
							"url": {
								"raw": "{{base_url}}/api/uploads/last",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads",
									"last"
								]
							},
							"description": "Discards (marks as Rejected) the last uploaded item for the authenticated user."
						},
						"response": []
					}
				],
				"auth": {
					"type": "inherit"
				}
			},
			{
				"name": "Admin Workflow",
				"item": [
					{
						"name": "Get All Uploads",
						"request": {
							"method": "GET",
							"header": [],
							"url": {
								"raw": "{{base_url}}/api/uploads?status=Pending&page=1&limit=10",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads"
								],
								"query": [
									{
										"key": "status",
										"value": "Pending"
									},
									{
										"key": "page",
										"value": "1"
									},
									{
										"key": "limit",
										"value": "10"
									}
								]
							},
							"description": "Retrieves a paginated list of all uploads. Can be filtered by status."
						},
						"response": []
					},
					{
						"name": "Get Specific Upload",
						"request": {
							"method": "GET",
							"header": [],
							"url": {
								"raw": "{{base_url}}/api/uploads/{{uploadId}}",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads",
									"{{uploadId}}"
								]
							},
							"description": "Retrieves a specific upload by its ID. Uses uploadId collection variable."
						},
						"response": []
					},
					{
						"name": "Update Upload Status",
						"request": {
							"method": "PATCH",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": {
								"mode": "raw",
								"raw": "{\n  \"status\": \"Rejected\",\n  \"message\": \"Rates are incorrect.\"\n}",
								"options": {
									"raw": {
										"language": "json"
									}
								}
							},
							"url": {
								"raw": "{{base_url}}/api/uploads/{{uploadId}}/status",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads",
									"{{uploadId}}",
									"status"
								]
							},
							"description": "Updates the status of a specific upload. Allowed values: Pending, Completed, Approved, Rejected. Uses uploadId collection variable."
						},
						"response": []
					},
					{
						"name": "Retrieve Uploaded Image",
						"request": {
							"method": "GET",
							"header": [],
							"url": {
								"raw": "{{base_url}}/api/uploads/image/{{uploadId}}",
								"host": [
									"{{base_url}}"
								],
								"path": [
									"api",
									"uploads",
									"image",
									"{{uploadId}}"
								]
							},
							"description": "Retrieves a previously uploaded image by its upload ID. Uses uploadId collection variable."
						},
						"response": []
					}
				],
				"auth": {
					"type": "inherit"
				}
			}
		],
		"auth": {
			"type": "bearer",
			"bearer": [
				{
					"key": "token",
					"value": "{{authToken}}",
					"type": "string"
				}
			]
		}
		},
		{
			"name": "5. Rate Analysis (Admin/SuperAdmin)",
			"item": [
				{
					"name": "Get Lowest/Highest Rate Summary",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/rates?date=2025-08-21&batch=10AM",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"rates"
							],
							"query": [
								{
									"key": "date",
									"value": "2025-08-21",
									"description": "(Required) Date in YYYY-MM-DD format"
								},
								{
									"key": "batch",
									"value": "10AM",
									"description": "(Optional) Can be '10AM' or '4PM'",
									"disabled": true
								}
							]
						},
						"description": "Retrieves a summary of the lowest and highest rates for a given date and optional batch."
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{authToken}}",
						"type": "string"
					}
				]
			}
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{authToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
