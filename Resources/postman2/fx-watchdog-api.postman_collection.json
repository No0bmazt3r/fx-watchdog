		{
			"name": "4. Rate Card Workflow",
			"item": [
				{
					"name": "Ops User Workflow",
					"item": [
						{
							"name": "Step 1a: Upload Image for Extraction",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"body": {
									"mode": "formdata",
									"formdata": [
										{
											"key": "image",
											"type": "file",
											"src": []
										},
										{
											"key": "branch",
											"value": "Main Branch",
											"type": "text"
										}
									]
								},
								"url": {
									"raw": "{{base_url}}/api/uploads",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"uploads"
									]
								},
								"description": "Uploads an image and branch name. The API returns extracted data with a 'Pending' status."
							},
							"response": [],
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"try {",
											"    let jsonData = pm.response.json();",
											"    if (jsonData && jsonData.uploadId) {",
											"        pm.environment.set('uploadId', jsonData.uploadId);",
											"        console.log('Upload ID saved:', jsonData.uploadId);",
											"    }",
											"    if (jsonData && jsonData.tempFileId) {",
											"        pm.environment.set('tempFileId', jsonData.tempFileId);",
											"        console.log('Temp File ID saved:', jsonData.tempFileId);",
											"    }",
											"} catch (e) {",
											"    console.error('Error parsing upload response:', e);",
											"}"
										]
									}
								}
							]
						},
						{
							"name": "Step 1b: Upload Text for Extraction",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									},
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"text\": \"Today Rate\\nDate:04/08/2025\\n\\n Ria. রিয়ার মাধ্যমে \\nবৈধ ভাবে দেশে টাকা পাঠান \\n BANGLADESH \\n Bank Account \\n28.75+2.5%= 29.46TAKA\\n \\n Pin/Cash Pickup 28.30+2.50%=29.00\\n \\nBkash 28.40+ 2.50%=29.10\\n\\nNEPAL.          =32.55\\nPAKISTAN    =66.00\\nINDIA             =20.30\\nMYANMAR   =1030.00\\nINDONESIA  =3802.88\\nPHILIPPINE  =13.55\\nSRI LANKA   =\\nVETNAM.           =\\n*This rate is available only at MEDAN PASAR BRANCH\\n\\n*Charge Rm10,15,20\\n\\n যেকোনো মুহূর্তে রেট পরিবর্তন হতে পারে।\\n\\n\",\n  \"branch\": \"Main Branch\"\n}"
								},
								"url": {
									"raw": "{{base_url}}/api/uploads",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"uploads"
									]
								},
								"description": "Uploads raw text for extraction. The API returns extracted data with a 'Pending' status."
							},
							"response": [],
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"try {",
											"    let jsonData = pm.response.json();",
											"    if (jsonData && jsonData.uploadId) {",
											"        pm.environment.set('uploadId', jsonData.uploadId);",
											"        console.log('Upload ID saved:', jsonData.uploadId);",
											"    }",
											"    if (jsonData && jsonData.tempFileId) {",
											"        pm.environment.set('tempFileId', jsonData.tempFileId);",
											"        console.log('Temp File ID saved:', jsonData.tempFileId);",
											"    }",
											"} catch (e) {",
											"    console.error('Error parsing upload response:', e);",
											"}"
										]
									}
								}
							]
						},
						{
							"name": "Step 2: Submit Verified Data",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									},
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"tempFileId\": \"{{tempFileId}}\",\n  \"uploadId\": \"{{uploadId}}\",\n  \"extractedData\": {\n    \"date\": \"2025-07-29\",\n    \"time\": \"09:30\",\n    \"branch\": \"Main Branch\",\n    \"rates\": {\n      \"IDR\": 3847.76,\n      \"PHP\": 13.51\n    }\n  }\n}"
								},
								"url": {
									"raw": "{{base_url}}/api/submit",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"submit"
									]
								},
								"description": "Submits the verified data. The body can be the direct response from the upload endpoint. On success, the upload status is changed to 'Completed'."
							},
							"response": []
						},
						{
							"name": "Get Upload History",
