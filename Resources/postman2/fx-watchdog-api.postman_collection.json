									"path": [
										"api",
										"uploads",
										"latest"
									]
								},
								"description": "Retrieves the latest upload for the authenticated user."
							},
							"response": []
						},
						{
							"name": "Discard Last Upload",
							"request": {
								"method": "DELETE",
								"header": [
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"url": {
									"raw": "{{base_url}}/api/uploads/last",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"uploads",
										"last"
									]
								},
								"description": "Discards (marks as Rejected) the last uploaded item for the authenticated user."
							},
							"response": []
						}
					]
				},
				{
					"name": "Admin Workflow",
					"item": [
						{
							"name": "Get All Uploads",
							"request": {
								"method": "GET",
								"header": [
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"url": {
									"raw": "{{base_url}}/api/uploads?status=Pending&page=1&limit=10",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"uploads"
									],
									"query": [
										{
											"key": "status",
											"value": "Pending"
										},
										{
											"key": "page",
											"value": "1"
										},
										{
											"key": "limit",
											"value": "10"
										}
									]
								},
								"description": "Retrieves a paginated list of all uploads. Can be filtered by status."
							},
							"response": []
						},
						{
							"name": "Get Specific Upload",
							"request": {
								"method": "GET",
								"header": [
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"url": {
									"raw": "{{base_url}}/api/uploads/{{uploadId}}",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"uploads",
										"{{uploadId}}"
									]
								},
								"description": "Retrieves a specific upload by its ID. Uses uploadId environment variable."
							},
							"response": []
						},
						{
							"name": "Update Upload Status",
							"request": {
								"method": "PATCH",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									},
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"status\": \"Rejected\"\n}"
								},
								"url": {
									"raw": "{{base_url}}/api/uploads/{{uploadId}}/status",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"uploads",
										"{{uploadId}}",
										"status"
									]
								},
								"description": "Updates the status of a specific upload. Allowed values: Pending, Completed, Rejected. Uses uploadId environment variable."
							},
							"response": []
						},
						{
							"name": "Retrieve Uploaded Image",
							"request": {
								"method": "GET",
								"header": [
									{
										"key": "x-auth-token",
										"value": "{{authToken}}"
									}
								],
								"url": {
									"raw": "{{base_url}}/api/uploads/image/{{uploadId}}",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
