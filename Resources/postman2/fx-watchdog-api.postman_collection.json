	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"SuperAdmin\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in a user and returns a JWT."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"try {",
									"    let jsonData = pm.response.json();",
									"    console.log('Login response received:', jsonData);",
									"    if (jsonData && jsonData.token) {",
									"        pm.environment.set('authToken', jsonData.token);",
									"        pm.environment.set('userId', jsonData.user.id);",
									"        pm.environment.set('username', jsonData.user.username);",
									"        pm.environment.set('userRole', jsonData.user.role);",
									"        console.log('authToken environment variable updated successfully.');",
									"    } else {",
									"        console.error('Error: Token not found in login response.');",
									"    }",
									"} catch (e) {",
									"    console.error('Error parsing login response:', e);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-auth-token",
								"value": "{{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"newPassword\": \"a_strong_password\"\n}"
						},
						"url": {
